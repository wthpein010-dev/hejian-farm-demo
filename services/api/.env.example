# Explicit local sandbox only. The application does not automatically load .env.
FARM_MODE=development
FARM_ALLOW_DEVELOPMENT_AUTH=true
FARM_HOST=127.0.0.1
FARM_PORT=8787
# FARM_DATABASE_PATH should be an absolute private filesystem path when set.
FARM_ALLOWED_ORIGINS=http://127.0.0.1:5174

# Optional official mini-program credentials. Configure each pair together in the
# server environment only. Leave both empty to keep the provider unavailable.
# Never commit an actual Secret or paste it into client configuration.
FARM_WEIXIN_APP_ID=
FARM_WEIXIN_APP_SECRET=
FARM_TOUTIAO_APP_ID=
FARM_TOUTIAO_APP_SECRET=
