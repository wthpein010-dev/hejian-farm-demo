{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "allowJs": true, "checkJs": false,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "lib": ["ES2020", "DOM"], "types": ["@dcloudio/types", "vite/client"],
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }, "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.mjs", "vite.config.ts"]
}
